---
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="px-6 py-10 sm:px-10">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-1 border-t border-[var(--color-rule)] pt-6 font-mono text-[0.7rem] uppercase tracking-widest text-[var(--color-ink-muted)] sm:flex-row sm:items-center sm:justify-between"
  >
    <span>© {year} noowah</span>
    <span>{t(locale, "footer.rights")}</span>
  </div>
</footer>
