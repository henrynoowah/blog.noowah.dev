---
import type { CollectionEntry } from "astro:content";
import { t, type Locale } from "../i18n/ui";
import type { Area } from "../i18n/areas";

interface Props {
  post: CollectionEntry<Area>;
  href: string;
  index: number;
  locale: Locale;
  areaLabel?: string;
  accent?: string;
}

const { post, href, index, locale, areaLabel, accent } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const dateLabel = new Intl.DateTimeFormat(locale, { dateStyle: "long" }).format(pubDate);
const num = String(index + 1).padStart(2, "0");
---

<article class="group relative">
  <a
    href={href}
    style={accent ? `--card-accent: ${accent}` : undefined}
    class="post-card reveal grid gap-x-6 gap-y-2 border border-[var(--color-rule)] p-6 transition-colors sm:grid-cols-[3.5rem_1fr] sm:p-8"
  >
    <span
      class="font-mono text-xs text-[var(--color-ink-muted)] transition-colors group-hover:text-[var(--card-accent,var(--color-accent))] sm:pt-1"
    >
      {num}
    </span>
    <div>
      <div class="flex flex-wrap items-center gap-3">
        <time
          datetime={pubDate.toISOString()}
          class="font-mono text-[0.7rem] uppercase tracking-widest text-[var(--color-ink-muted)]"
        >
          {dateLabel}
        </time>
        {areaLabel && (
          <span
            class="border border-[var(--color-rule)] px-2 py-0.5 font-mono text-[0.6rem] uppercase tracking-widest text-[var(--color-ink-muted)]"
          >
            {areaLabel}
          </span>
        )}
      </div>
      <h2
        class="mt-2 font-display text-2xl font-bold leading-tight text-[var(--color-ink)] transition-colors group-hover:text-[var(--card-accent,var(--color-accent))] break-keep sm:text-3xl"
      >
        {title}
      </h2>
      <p class="mt-2 max-w-xl text-[var(--color-ink-muted)] break-keep">{description}</p>
      <div class="mt-5 flex flex-wrap items-center gap-2">
        {tags.map((tag) => (
          <span
            class="border border-[var(--color-rule)] px-2 py-0.5 font-mono text-[0.65rem] uppercase tracking-widest text-[var(--color-ink-muted)]"
          >
            {tag}
          </span>
        ))}
        <span
          class="ml-auto font-mono text-[0.7rem] uppercase tracking-widest text-[var(--card-accent,var(--color-accent))] opacity-0 transition-opacity group-hover:opacity-100"
        >
          {t(locale, "post.readMore")} →
        </span>
      </div>
    </div>
  </a>
</article>
