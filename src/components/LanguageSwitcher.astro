---
import { languages, t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const label = t(locale, "lang.switch");

function pathFor(target: Locale): string {
  const segments = Astro.url.pathname.split("/").filter(Boolean);
  segments[0] = target;
  return "/" + segments.join("/") + (segments.length <= 1 ? "/" : "");
}
---

<nav aria-label={label} class="flex items-stretch font-mono text-xs uppercase tracking-widest">
  {
    Object.keys(languages).map((code) =>
      code === locale ? (
        <span class="bg-[var(--color-ink)] px-2.5 py-2 text-[var(--color-paper)]">{code}</span>
      ) : (
        <a
          href={pathFor(code as Locale)}
          class="px-2.5 py-2 text-[var(--color-ink-muted)] transition-colors hover:bg-[var(--color-ochre)] hover:text-[#211f1b]"
        >
          {code}
        </a>
      )
    )
  }
</nav>
