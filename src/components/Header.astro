---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { t, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<header class="px-6 pt-10 sm:px-10 sm:pt-14">
  <div class="mx-auto flex max-w-3xl flex-wrap items-start justify-between gap-6">
    <a href={`/${locale}/`} class="group inline-block">
      <span
        class="block font-display text-4xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-5xl"
      >
        {t(locale, "site.title")}<span class="text-[var(--color-accent)]">.</span>
      </span>
      <span
        class="mt-1 block font-mono text-[0.7rem] uppercase tracking-[0.2em] text-[var(--color-ink-muted)]"
      >
        {t(locale, "site.tagline")}
      </span>
    </a>

    <div class="flex items-center gap-4 pt-2">
      <a
        href={`/${locale}/`}
        class="font-mono text-xs uppercase tracking-widest text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-ink)]"
      >
        {t(locale, "nav.writing")}
      </a>
      <LanguageSwitcher locale={locale} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
  <div class="mx-auto mt-8 max-w-3xl border-t border-[var(--color-rule)]"></div>
</header>
