---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { languages, t, type Locale } from "../../i18n/ui";
import {
  areas,
  areaLabel,
  areaDescription,
  areaTopics,
  areaHref,
  postHref,
  type Area,
} from "../../i18n/areas";
import { getAreaPosts, getAllPosts, slugOf } from "../../lib/posts";

export async function getStaticPaths() {
  return Promise.all(
    (Object.keys(languages) as Locale[]).map(async (locale) => ({
      params: { locale },
      props: {
        sections: await Promise.all(
          areas.map(async (area) => ({ area, posts: await getAreaPosts(area, locale) }))
        ),
        latest: (await getAllPosts(locale)).slice(0, 4),
      },
    }))
  );
}

const { locale } = Astro.params as { locale: Locale };
const { sections, latest } = Astro.props;

const countLabel = (n: number) =>
  `${n} ${t(locale, n === 1 ? "area.count.one" : "area.count.other")}`;
---

<BaseLayout title={t(locale, "site.title")} description={t(locale, "site.tagline")}>
  <!-- Hero -->
  <section class="hero-glow px-6 pb-24 pt-10 sm:px-10 sm:pb-32 sm:pt-16">
    <div class="relative z-10 mx-auto max-w-5xl">
      <h1
        class="font-display font-bold leading-[0.95] tracking-tight text-[var(--color-ink)] break-keep text-[clamp(2.25rem,8vw,6rem)]"
      >
        <span class="rise block" style="animation-delay: 60ms">{t(locale, "home.hero.line1")}</span>
        <span class="rise block" style="animation-delay: 160ms">{t(locale, "home.hero.line2")}</span>
        <span
          class="rise block text-[var(--color-accent)]"
          style="animation-delay: 260ms"
        >
          {t(locale, "home.hero.line3")}
        </span>
      </h1>
      <p
        class="rise mt-8 max-w-md text-lg leading-relaxed text-[var(--color-ink-muted)] break-keep sm:mt-10"
        style="animation-delay: 400ms"
      >
        {t(locale, "home.hero.lede")}
      </p>
    </div>
  </section>

  <!-- Areas -->
  <section class="px-6 pb-24 sm:px-10 sm:pb-32">
    <div class="mx-auto max-w-5xl">
      <div class="flex items-center gap-4">
        <span class="h-px w-8 bg-[var(--color-accent)]"></span>
        <span
          class="font-mono text-[0.65rem] uppercase tracking-[0.25em] text-[var(--color-ink-muted)]"
        >
          {t(locale, "home.areas.label")}
        </span>
      </div>

      <div class="mt-8 border-b border-[var(--color-rule)]">
        {
          sections.map(({ area, posts }, i) => (
            <a
              href={areaHref(locale, area as Area)}
              class="area-row reveal group relative block overflow-hidden border-t border-[var(--color-rule)] py-10 sm:py-14"
            >
              <div class="relative z-10 grid gap-5 px-4 sm:grid-cols-[3rem_1fr_auto] sm:items-start sm:gap-10 sm:px-6">
                <span
                  class="font-mono text-sm text-[var(--color-ink-muted)] transition-colors group-hover:text-[var(--color-accent)]"
                >
                  {String(i + 1).padStart(2, "0")}
                </span>

                <div>
                  <h2
                    class="font-display text-3xl font-bold leading-none tracking-tight text-[var(--color-ink)] transition-transform duration-500 ease-out group-hover:translate-x-1 sm:text-5xl"
                  >
                    {areaLabel(locale, area as Area)}
                  </h2>
                  <p class="mt-4 max-w-md text-[var(--color-ink-muted)] break-keep">
                    {areaDescription(locale, area as Area)}
                  </p>
                  <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-1.5">
                    {areaTopics(locale, area as Area).map((topic) => (
                      <li class="font-mono text-[0.7rem] uppercase tracking-widest text-[var(--color-ink-muted)]">
                        {topic}
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="flex items-center gap-4 sm:flex-col sm:items-end sm:gap-6">
                  <span
                    class="font-mono text-[0.7rem] uppercase tracking-widest text-[var(--color-ink-muted)]"
                  >
                    {posts.length === 0 ? t(locale, "area.empty.short") : countLabel(posts.length)}
                  </span>
                  <svg
                    class="h-5 w-5 shrink-0 text-[var(--color-ink-muted)] transition-all duration-500 ease-out group-hover:translate-x-1 group-hover:text-[var(--color-accent)]"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 12h15m0 0-6-6m6 6-6 6" />
                  </svg>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Latest -->
  {
    latest.length > 0 && (
      <section class="px-6 pb-24 sm:px-10 sm:pb-32">
        <div class="mx-auto max-w-5xl">
          <div class="flex items-center gap-4">
            <span class="h-px w-8 bg-[var(--color-accent)]" />
            <span class="font-mono text-[0.65rem] uppercase tracking-[0.25em] text-[var(--color-ink-muted)]">
              {t(locale, "home.latest.label")}
            </span>
          </div>

          <div class="mt-8 border-b border-[var(--color-rule)]">
            {latest.map((post) => {
              const area = post.collection as Area;
              return (
                <a
                  href={postHref(locale, area, slugOf(post, locale))}
                  class="reveal group flex flex-wrap items-baseline gap-x-5 gap-y-2 border-t border-[var(--color-rule)] px-4 py-5 transition-colors hover:bg-[color-mix(in_oklab,var(--color-accent)_6%,transparent)] sm:px-6"
                >
                  <span class="rounded-full border border-[var(--color-rule)] px-2.5 py-0.5 font-mono text-[0.6rem] uppercase tracking-widest text-[var(--color-ink-muted)]">
                    {areaLabel(locale, area)}
                  </span>
                  <h3 class="flex-1 font-display text-base font-semibold text-[var(--color-ink)] transition-colors group-hover:text-[var(--color-accent)] break-keep sm:text-lg">
                    {post.data.title}
                  </h3>
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="font-mono text-[0.7rem] uppercase tracking-widest text-[var(--color-ink-muted)]"
                  >
                    {new Intl.DateTimeFormat(locale, { dateStyle: "medium" }).format(
                      post.data.pubDate
                    )}
                  </time>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <!-- Closing -->
  <section class="px-6 pb-28 sm:px-10 sm:pb-36">
    <div class="mx-auto max-w-5xl">
      <div class="flex items-center gap-4">
        <span class="h-px w-8 bg-[var(--color-accent)]"></span>
        <span
          class="font-mono text-[0.65rem] uppercase tracking-[0.25em] text-[var(--color-ink-muted)]"
        >
          {t(locale, "home.closing.label")}
        </span>
      </div>

      <p
        class="reveal mt-8 max-w-xl font-display text-xl font-semibold leading-snug tracking-tight text-[var(--color-ink)] break-keep sm:text-2xl"
      >
        {t(locale, "home.closing.text")}
      </p>

      <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
        {
          [
            { href: "https://noowah.dev", label: t(locale, "home.closing.portfolio") },
            { href: "https://github.com/henrynoowah", label: t(locale, "home.closing.github") },
          ].map((link) => (
            <a
              href={link.href}
              class="group inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-[var(--color-ink)] transition-colors hover:text-[var(--color-accent)]"
            >
              {link.label}
              <svg
                class="h-3.5 w-3.5 transition-transform duration-300 ease-out group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7m0 0H8m9 0v9" />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
