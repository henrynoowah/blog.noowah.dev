---
import HomePage from "../../components/HomePage.astro";
import { languages, type Locale } from "../../i18n/ui";
import { areas } from "../../i18n/areas";
import { getAreaPosts, getAllPosts } from "../../lib/posts";

export async function getStaticPaths() {
  return Promise.all(
    (Object.keys(languages) as Locale[]).map(async (locale) => ({
      params: { locale },
      props: {
        sections: await Promise.all(
          areas.map(async (area) => ({ area, posts: await getAreaPosts(area, locale) }))
        ),
        latest: (await getAllPosts(locale)).slice(0, 4),
      },
    }))
  );
}

const { locale } = Astro.params as { locale: Locale };
const { sections, latest } = Astro.props;
---

<HomePage locale={locale} sections={sections} latest={latest} />
