---
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Toc from "../../../components/Toc.astro";
import { languages, type Locale } from "../../../i18n/ui";
import { areas, areaLabel, areaColor, areaShape, type Area } from "../../../i18n/areas";
import { getAreaPosts, slugOf } from "../../../lib/posts";

export async function getStaticPaths() {
  const groups = await Promise.all(
    (Object.keys(languages) as Locale[]).flatMap((locale) =>
      areas.map(async (area) => {
        const posts = await getAreaPosts(area, locale);
        return posts.map((post) => ({
          params: { locale, area, slug: slugOf(post, locale) },
          props: { post },
        }));
      })
    )
  );
  return groups.flat();
}

const { locale, area } = Astro.params as { locale: Locale; area: Area };
const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const { Content, headings } = await render(post);
const dateLabel = new Intl.DateTimeFormat(locale, { dateStyle: "long" }).format(pubDate);
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-5xl px-6 pb-24 pt-4 sm:px-10">
    <a
      href={`/${locale}/${area}/`}
      class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-[var(--color-ink)] transition-colors hover:text-[var(--color-ink-muted)]"
    >
      <span
        class={`h-2.5 w-2.5 ${areaShape(area) === "circle" ? "shape-circle" : ""}`}
        style={`background: ${areaColor(area)}`}></span>
      ← {areaLabel(locale, area)}
    </a>

    <header class="mt-8 max-w-2xl border-b border-[var(--color-rule)] pb-8">
      <time
        datetime={pubDate.toISOString()}
        class="font-mono text-[0.7rem] uppercase tracking-widest text-[var(--color-ink-muted)]"
      >
        {dateLabel}
      </time>
      <h1
        class="mt-3 font-display text-4xl font-black leading-[1.05] tracking-tight text-[var(--color-ink)] break-keep sm:text-5xl"
      >
        {title}
      </h1>
      <span
        class="mt-6 block h-1 w-24"
        style={`background: ${areaColor(area)}`}
        aria-hidden="true"></span>
      {tags.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span
              class="border border-[var(--color-rule)] px-2 py-0.5 font-mono text-[0.65rem] uppercase tracking-widest text-[var(--color-ink-muted)]"
            >
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="mt-10 lg:flex lg:gap-12">
      <div class="min-w-0 flex-1">
        <Toc
          headings={headings}
          locale={locale}
          class="mb-10 border-l-2 border-[var(--color-rule)] pl-4 lg:hidden"
        />
        <div class="prose max-w-2xl">
          <Content />
        </div>
      </div>
      <aside class="hidden lg:block">
        <Toc
          headings={headings}
          locale={locale}
          class="sticky top-8 max-h-[calc(100vh-4rem)] w-56 overflow-y-auto"
        />
      </aside>
    </div>
  </article>

  <script>
    const links = [...document.querySelectorAll("[data-toc-link]")];
    const headings = [...document.querySelectorAll(".prose h2[id], .prose h3[id]")];
    if (links.length && headings.length) {
      // ponytail: IntersectionObserver scroll-spy — 표준 최소 구현. rootMargin으로 "상단 근처" 헤딩을 활성 처리.
      const setActive = (id: string) =>
        links.forEach((a) =>
          a.toggleAttribute("data-active", a.getAttribute("href") === "#" + id)
        );
      const seen = new Set<string>();
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) seen.add(e.target.id);
            else seen.delete(e.target.id);
          }
          const first = headings.find((h) => seen.has(h.id));
          if (first) setActive(first.id);
        },
        { rootMargin: "0px 0px -70% 0px" }
      );
      headings.forEach((h) => io.observe(h));
    }
  </script>
</BaseLayout>
