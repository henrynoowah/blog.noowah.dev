---
import { render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { languages, type Locale } from "../../../i18n/ui";
import { areas, areaLabel, type Area } from "../../../i18n/areas";
import { getAreaPosts, slugOf } from "../../../lib/posts";

export async function getStaticPaths() {
  const groups = await Promise.all(
    (Object.keys(languages) as Locale[]).flatMap((locale) =>
      areas.map(async (area) => {
        const posts = await getAreaPosts(area, locale);
        return posts.map((post) => ({
          params: { locale, area, slug: slugOf(post, locale) },
          props: { post },
        }));
      })
    )
  );
  return groups.flat();
}

const { locale, area } = Astro.params as { locale: Locale; area: Area };
const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const { Content } = await render(post);
const dateLabel = new Intl.DateTimeFormat(locale, { dateStyle: "long" }).format(pubDate);
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-5xl px-6 pb-24 pt-4 sm:px-10">
    <a
      href={`/${locale}/${area}/`}
      class="inline-flex items-center gap-1 font-mono text-xs uppercase tracking-widest text-[var(--color-ink-muted)] transition-colors hover:text-[var(--color-accent)]"
    >
      ← {areaLabel(locale, area)}
    </a>

    <header class="mt-8 max-w-2xl border-b border-[var(--color-rule)] pb-8">
      <time
        datetime={pubDate.toISOString()}
        class="font-mono text-[0.7rem] uppercase tracking-widest text-[var(--color-ink-muted)]"
      >
        {dateLabel}
      </time>
      <h1
        class="mt-2 font-display text-3xl font-bold leading-tight text-[var(--color-ink)] sm:text-4xl"
      >
        {title}
      </h1>
      {tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span
              class="rounded-full border border-[var(--color-rule)] px-2.5 py-0.5 font-mono text-[0.65rem] uppercase tracking-widest text-[var(--color-ink-muted)]"
            >
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="prose mt-10 max-w-2xl">
      <Content />
    </div>
  </article>
</BaseLayout>
