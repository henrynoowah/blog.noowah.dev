---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import { languages, t, type Locale } from "../../../i18n/ui";
import {
  areas,
  areaLabel,
  areaDescription,
  areaColor,
  areaShape,
  type Area,
} from "../../../i18n/areas";
import { getAreaPosts, slugOf } from "../../../lib/posts";

export async function getStaticPaths() {
  return Promise.all(
    (Object.keys(languages) as Locale[]).flatMap((locale) =>
      areas.map(async (area) => ({
        params: { locale, area },
        props: { posts: await getAreaPosts(area, locale) },
      }))
    )
  );
}

const { locale, area } = Astro.params as { locale: Locale; area: Area };
const { posts } = Astro.props;
const label = areaLabel(locale, area);
const description = areaDescription(locale, area);
---

<BaseLayout title={label} description={description}>
  <div class="mx-auto max-w-5xl px-6 pb-24 pt-6 sm:px-10">
    <header class="border-b border-[var(--color-rule)] pb-8">
      <span
        class={`mb-5 block h-8 w-8 ${areaShape(area) === "circle" ? "shape-circle" : ""}`}
        style={`background: ${areaColor(area)}`}
        aria-hidden="true"></span>
      <h1
        class="lowercase-bauhaus font-display text-5xl font-black leading-none tracking-tight sm:text-7xl"
        style={`color: ${areaColor(area)}`}
      >
        {label}
      </h1>
      <p class="mt-4 max-w-xl text-[var(--color-ink-muted)] break-keep">{description}</p>
    </header>

    <div class="mt-8 flex flex-col gap-5">
      {
        posts.length === 0 ? (
          <p class="py-16 text-center text-[var(--color-ink-muted)]">{t(locale, "post.empty")}</p>
        ) : (
          posts.map((post, index) => (
            <PostCard
              post={post}
              index={index}
              locale={locale}
              accent={areaColor(area)}
              href={`/${locale}/${area}/${slugOf(post, locale)}`}
            />
          ))
        )
      }
    </div>
  </div>
</BaseLayout>
